// Versionssidan (F-40–F-45): https://leo-versioner.niklasstolpe.workers.dev
// Workern (src/index.js) ritar sidan vid varje besök, loggar in med Google och publicerar via
// Cloudflares API. Datat (dist/versioner.json) och typsnitten byggs av scripts/versioner.sh.
// Secrets – sätts av Admin i Cloudflare (Workers → leo-versioner → Settings → Variables and Secrets):
//   GOOGLE_CLIENT_SECRET  från Google Cloud Console
//   CF_API_TOKEN          Cloudflare-nyckel med Workers Scripts: Edit
//   SESSION_SECRET        slumpad, sätts av scripts/versioner.sh första gången
{
  "$schema": "../site/node_modules/wrangler/config-schema.json",
  "name": "leo-versioner",
  "main": "src/index.js",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "ACCOUNT_ID": "4785debd7d2639fd0117680002a5b41d",
    "GOOGLE_CLIENT_ID": "4424521176-8tniojp6mjsvkl65njngb277r9gsjr37.apps.googleusercontent.com",
    "TILLATNA": "niklasstolpe@gmail.com,lowejkoleo@gmail.com"
  },
  "workers_dev": true,
  "preview_urls": false
}
