---
// Ornament efter käpparnas ringar vid halsen: tunna linjer, en dubbelring och en romb i mässing.
interface Props {
  class?: string;
}
const { class: klass } = Astro.props;
---

<div class:list={['ringar', klass]} aria-hidden="true">
  <span class="linje vanster"></span>
  <svg viewBox="0 0 64 16" width="64" height="16">
    <line x1="0" y1="5" x2="22" y2="5" />
    <line x1="0" y1="11" x2="22" y2="11" />
    <path d="M32 2 L38 8 L32 14 L26 8 Z" />
    <line x1="42" y1="5" x2="64" y2="5" />
    <line x1="42" y1="11" x2="64" y2="11" />
  </svg>
  <span class="linje hoger"></span>
</div>

<style>
  .ringar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--massing);
    max-width: 28rem;
    margin: 0 auto;
  }
  .linje {
    flex: 1;
    height: 1px;
  }
  .vanster {
    background: linear-gradient(to right, transparent, currentColor);
  }
  .hoger {
    background: linear-gradient(to left, transparent, currentColor);
  }
  svg {
    flex: none;
    stroke: currentColor;
    stroke-width: 1;
    fill: none;
  }
  path {
    fill: currentColor;
    stroke: none;
  }
</style>
