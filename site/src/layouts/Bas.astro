---
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/400-italic.css';
import '@fontsource/cormorant-garamond/600.css';
import '@fontsource/jost/300.css';
import '@fontsource/jost/400.css';
import Ringar from '../components/Ringar.astro';
import { appNamn, arProd, favicon, ikon, temafarg } from '../lib/miljo';

interface Props {
  titel: string;
  beskrivning?: string;
  /** Bild som visas när länken delas (F-30). Absolut eller rot-relativ URL. */
  delningsbild?: string;
  /** Huvudet ligger ovanpå sidans första bild (startsidan, #41). */
  overBild?: boolean;
}
const { titel, beskrivning = 'Handgjorda käppar av Leo Lowejko – konsthantverk i exklusiva träslag, gjorda för att användas.', delningsbild, overBild = false } = Astro.props;
// Menyn (#41, #57): få, tydliga sidor – samma i huvudet och foten. Beställningssidan nås från startsidan.
const MENY = [
  { href: '/#samlingen', text: 'Käpparna' },
  { href: '/om/', text: 'Om Leo' },
  { href: '/kontakt/', text: 'Kontakt' },
];
const ar = new Date().getFullYear();
const bildUrl = delningsbild ? new URL(delningsbild, Astro.url).href : undefined;
// Kanonisk adress (NF-04): samma sida kan nås på flera adresser (versionslänkar, stage) – den här räknas.
const kanonisk = new URL(Astro.url.pathname, Astro.site).href;
---

<html lang="sv">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={beskrivning} />
    <meta name="theme-color" content={temafarg} />
    {!arProd && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={titel} />
    <meta property="og:description" content={beskrivning} />
    {bildUrl && <meta property="og:image" content={bildUrl} />}
    <link rel="canonical" href={kanonisk} />
    <meta property="og:url" content={kanonisk} />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <link rel="apple-touch-icon" href={ikon(180)} />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="apple-mobile-web-app-title" content={appNamn} />
    <title>{titel}</title>
  </head>
  <body>
    <header class:list={['huvud', { 'over-bild': overBild }]}>
      <a class="marke" href="/">llcanes</a>
      <nav class="bred" aria-label="Huvudmeny">
        {MENY.map((m) => <a href={m.href}>{m.text}</a>)}
      </nav>
      <details class="smal">
        <summary aria-label="Meny">Meny</summary>
        <nav aria-label="Huvudmeny">
          {MENY.map((m) => <a href={m.href}>{m.text}</a>)}
        </nav>
      </details>
    </header>
    <slot />
    <footer class="fot">
      <Ringar />
      <nav class="fotmeny" aria-label="Sidfot">
        {MENY.map((m) => <a href={m.href}>{m.text}</a>)}
      </nav>
      <p>© Leo {ar}</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --svart: #0e0d0b;
    --yta: #17150f;
    --elfenben: #ece4d4;
    --dampad: #a39985;
    --massing: #b8955a;
    --massing-ljus: #d4b27a;
    --serif: 'Cormorant Garamond', Georgia, 'Times New Roman', serif;
    --sans: 'Jost', 'Futura', 'Helvetica Neue', Arial, sans-serif;
    /* Stilen (#41): typsnitt, tyngd och kursiv – versionerna byter här.
       Klassisk (version 8 och 10): Cormorant, kursiva rubriker. Modern (version 9): var(--sans), 300, normal. */
    --rubrik: var(--serif);
    --rubrik-vikt: 400;
    --rubrik-stil: italic;
    --brodtext: var(--serif);
    --brodtext-vikt: 400;
    --kursiv: italic;
    --versal-vikt: 600;
    /* Samlingens bakgrund och text. Ljus (version 10): elfenben bakom käpparna – de mörka bilderna
       lyfter som tavlor på en vägg. Mörk (version 8, 9): var(--svart), var(--elfenben), var(--dampad). */
    --samling-bg: #d4b27a;
    --samling-text: #1f1c18;
    --samling-dampad: #4a4339;
    --samling-accent: #5a3f18;
  }
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  html {
    scroll-behavior: smooth;
  }
  body {
    margin: 0;
    background: var(--svart);
    color: var(--elfenben);
    font-family: var(--brodtext);
    font-weight: var(--brodtext-vikt);
    font-size: 1.2rem;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }
  a {
    color: inherit;
  }
  img {
    display: block;
    max-width: 100%;
    height: auto;
  }
  .versaler {
    text-transform: uppercase;
    letter-spacing: 0.3em;
    font-size: 0.8rem;
    font-weight: var(--versal-vikt);
  }
  :focus-visible {
    outline: 1px solid var(--massing-ljus);
    outline-offset: 4px;
  }
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
    * {
      transition: none !important;
    }
  }
</style>

<style>
  .huvud {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem clamp(1rem, 4vw, 3rem);
    border-bottom: 1px solid rgb(184 149 90 / 0.25);
    position: relative;
    z-index: 2;
  }
  .huvud.over-bild {
    position: absolute;
    inset: 0 0 auto;
    border-bottom-color: transparent;
    background: linear-gradient(rgb(14 13 11 / 0.7), transparent);
  }
  .bred {
    display: none;
    gap: 2rem;
  }
  .smal summary {
    list-style: none;
    cursor: pointer;
    text-transform: uppercase;
    letter-spacing: 0.25em;
    font-size: 1.07rem;
    font-weight: var(--versal-vikt);
    color: var(--dampad);
    min-height: 44px;
    display: flex;
    align-items: center;
  }
  .smal summary::-webkit-details-marker {
    display: none;
  }
  .smal[open] nav {
    position: absolute;
    right: clamp(1rem, 4vw, 3rem);
    top: 100%;
    display: flex;
    flex-direction: column;
    background: var(--yta);
    border: 1px solid rgb(184 149 90 / 0.4);
    padding: 0.5rem 1.25rem;
    min-width: 14rem;
  }
  @media (min-width: 56rem) {
    .bred {
      display: flex;
    }
    .smal {
      display: none;
    }
  }
  .marke {
    text-decoration: none;
    letter-spacing: 0.2em;
    font-size: 1.3rem;
    font-weight: var(--versal-vikt);
    color: var(--massing-ljus);
  }
  nav a {
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.25em;
    font-size: 0.8rem;
    font-weight: var(--versal-vikt);
    color: var(--dampad);
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  nav a:hover {
    color: var(--elfenben);
  }
  /* Menyn i huvudet större än i foten (#57) – foten behåller den lilla texten. */
  .huvud nav a {
    font-size: 1.07rem;
  }
  .fot {
    padding: 4rem 1rem 3rem;
    text-align: center;
    color: var(--dampad);
    font-size: 0.95rem;
  }
  .fotmeny {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem 1.5rem;
    margin-top: 1.5rem;
  }
  .fot p {
    margin: 1.25rem 0 0;
    letter-spacing: 0.1em;
  }
</style>
