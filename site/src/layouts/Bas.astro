---
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/400-italic.css';
import '@fontsource/cormorant-garamond/600.css';
import '@fontsource/jost/300.css';
import '@fontsource/jost/400.css';
import Ringar from '../components/Ringar.astro';
import { appNamn, arProd, favicon, ikon, temafarg } from '../lib/miljo';
import { T, prefix, motsvarande, type Sprak } from '../lib/sprak';

interface Props {
  /** Språk (F-63): svenska i roten, engelska under /en/. */
  sprak?: Sprak;
  /** Visa knappen till andra språket (false på sidan "finns inte"). */
  sprakLank?: boolean;
  titel: string;
  beskrivning?: string;
  /** Bild som visas när länken delas (F-30). Absolut eller rot-relativ URL. */
  delningsbild?: string;
  /** Huvudet ligger ovanpå sidans första bild (startsidan, #41). */
  overBild?: boolean;
}
const { sprak = 'sv', titel, delningsbild, overBild = false, sprakLank = true } = Astro.props;
const t = T[sprak];
const { beskrivning = t.beskrivning } = Astro.props;
const pre = prefix(sprak);
// Menyn (#41, #57): få, tydliga sidor – samma i huvudet och foten. Beställningssidan nås från startsidan.
// Sist en knapp till andra språket (F-63).
const andraSprak = motsvarande(Astro.url.pathname, sprak);
const MENY = [
  { href: `${pre}/#samlingen`, text: t.meny.kappar },
  { href: `${pre}/om/`, text: t.meny.om },
  { href: `${pre}/kontakt/`, text: t.meny.kontakt },
];
const SPRAKLANK = { href: andraSprak, text: t.sprakKnapp, lang: t.sprakKnappLang };
// Kontaktuppgifterna öppnas under "Kontakt" på datorn – uppe i huvudet och nere i foten.
const uppgifter = t.uppgifter;
const ar = new Date().getFullYear();
const bildUrl = delningsbild ? new URL(delningsbild, Astro.url).href : undefined;
// Kanonisk adress (NF-04): samma sida kan nås på flera adresser (versionslänkar, stage) – den här räknas.
const kanonisk = new URL(Astro.url.pathname, Astro.site).href;
---

<html lang={t.lang}>
  <head>
    {sprakLank && <link rel="alternate" hreflang={t.sprakKnappLang} href={new URL(andraSprak, Astro.site).href} />}
    {sprakLank && <link rel="alternate" hreflang={t.lang} href={kanonisk} />}
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={beskrivning} />
    <meta name="theme-color" content={temafarg} />
    {!arProd && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={titel} />
    <meta property="og:description" content={beskrivning} />
    {bildUrl && <meta property="og:image" content={bildUrl} />}
    <link rel="canonical" href={kanonisk} />
    <meta property="og:url" content={kanonisk} />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <link rel="apple-touch-icon" href={ikon(180)} />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="apple-mobile-web-app-title" content={appNamn} />
    <title>{titel}</title>
  </head>
  <body>
    <header class:list={['huvud', { 'over-bild': overBild }]}>
      <a class="marke" href={`${pre}/`}>llcanes</a>
      <nav class="bred" aria-label={t.huvudmeny}>
        {MENY.map((m) => m.href === `${pre}/kontakt/` ? (
          <details class="kontakt-ruta">
            <summary>{t.meny.kontakt}</summary>
            <address class="uppgifter">
              {uppgifter.map((u) => u.includes('@') ? <a href={`mailto:${u}`}>{u}</a> : <span>{u}</span>)}
            </address>
          </details>
        ) : <a href={m.href}>{m.text}</a>)}
        {sprakLank && <a class="sprak" href={SPRAKLANK.href} hreflang={SPRAKLANK.lang} lang={SPRAKLANK.lang}>{SPRAKLANK.text}</a>}
      </nav>
      <details class="smal">
        <summary aria-label={t.meny.knapp}>{t.meny.knapp}</summary>
        <nav aria-label={t.huvudmeny}>
          {MENY.map((m) => <a href={m.href}>{m.text}</a>)}
          {sprakLank && <a class="sprak" href={SPRAKLANK.href} hreflang={SPRAKLANK.lang} lang={SPRAKLANK.lang}>{SPRAKLANK.text}</a>}
        </nav>
      </details>
    </header>
    <slot />
    <footer class="fot">
      <Ringar />
      <nav class="fotmeny" aria-label={t.sidfot}>
        {MENY.map((m) => m.href === `${pre}/kontakt/` ? (
          <>
            <a class="kontakt-smal" href={m.href}>{m.text}</a>
            <details class="kontakt-ruta kontakt-bred">
              <summary>{t.meny.kontakt}</summary>
              <address class="uppgifter">
                {uppgifter.map((u) => u.includes('@') ? <a href={`mailto:${u}`}>{u}</a> : <span>{u}</span>)}
              </address>
            </details>
          </>
        ) : <a href={m.href}>{m.text}</a>)}
        {sprakLank && <a class="sprak" href={SPRAKLANK.href} hreflang={SPRAKLANK.lang} lang={SPRAKLANK.lang}>{SPRAKLANK.text}</a>}
      </nav>
      <p>© Leo {ar}</p>
    </footer>
    <script>
      // Menyn på telefonen stängs av sig själv efter 8 sekunder.
      const meny = document.querySelector<HTMLDetailsElement>('.smal');
      let timer: number | undefined;
      meny?.addEventListener('toggle', () => {
        clearTimeout(timer);
        if (meny.open) timer = window.setTimeout(() => (meny.open = false), 8000);
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --svart: #0e0d0b;
    --yta: #17150f;
    --elfenben: #ece4d4;
    --dampad: #a39985;
    --massing: #b8955a;
    --massing-ljus: #d4b27a;
    --serif: 'Cormorant Garamond', Georgia, 'Times New Roman', serif;
    --sans: 'Jost', 'Futura', 'Helvetica Neue', Arial, sans-serif;
    /* Stilen (#41): typsnitt, tyngd och kursiv – versionerna byter här.
       Klassisk (version 8 och 10): Cormorant, kursiva rubriker. Modern (version 9): var(--sans), 300, normal. */
    --rubrik: var(--serif);
    --rubrik-vikt: 400;
    --rubrik-stil: italic;
    --brodtext: var(--serif);
    --brodtext-vikt: 400;
    --kursiv: italic;
    --versal-vikt: 600;
    /* Samlingens bakgrund och text. Ljus (version 10): elfenben bakom käpparna – de mörka bilderna
       lyfter som tavlor på en vägg. Mörk (version 8, 9): var(--svart), var(--elfenben), var(--dampad). */
    --samling-bg: #e0c590;
    --samling-text: #1f1c18;
    --samling-dampad: #4a4339;
    --samling-accent: #5a3f18;
  }
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  html {
    scroll-behavior: smooth;
  }
  body {
    margin: 0;
    background: var(--svart);
    color: var(--elfenben);
    font-family: var(--brodtext);
    font-weight: var(--brodtext-vikt);
    font-size: 1.2rem;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }
  a {
    color: inherit;
  }
  img {
    display: block;
    max-width: 100%;
    height: auto;
  }
  .versaler {
    text-transform: uppercase;
    letter-spacing: 0.3em;
    font-size: 0.8rem;
    font-weight: var(--versal-vikt);
  }
  :focus-visible {
    outline: 1px solid var(--massing-ljus);
    outline-offset: 4px;
  }
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
    * {
      transition: none !important;
    }
  }
</style>

<style>
  .huvud {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem clamp(1rem, 4vw, 3rem);
    border-bottom: 1px solid rgb(184 149 90 / 0.25);
    position: relative;
    z-index: 2;
  }
  .huvud.over-bild {
    position: absolute;
    inset: 0 0 auto;
    border-bottom-color: transparent;
    background: linear-gradient(rgb(14 13 11 / 0.7), transparent);
  }
  .bred {
    display: none;
    gap: 2rem;
  }
  .smal summary {
    list-style: none;
    cursor: pointer;
    text-transform: uppercase;
    letter-spacing: 0.25em;
    font-size: 1.07rem;
    font-weight: var(--versal-vikt);
    color: var(--dampad);
    min-height: 44px;
    display: flex;
    align-items: center;
  }
  .smal summary::-webkit-details-marker {
    display: none;
  }
  .smal[open] nav {
    position: absolute;
    right: clamp(1rem, 4vw, 3rem);
    top: 100%;
    display: flex;
    flex-direction: column;
    background: var(--yta);
    border: 1px solid rgb(184 149 90 / 0.4);
    padding: 0.5rem 1.25rem;
    min-width: 14rem;
  }
  @media (min-width: 56rem) {
    .bred {
      display: flex;
    }
    .smal {
      display: none;
    }
  }
  .marke {
    text-decoration: none;
    letter-spacing: 0.2em;
    font-size: 1.3rem;
    font-weight: var(--versal-vikt);
    color: var(--massing-ljus);
  }
  nav a {
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.25em;
    font-size: 0.8rem;
    font-weight: var(--versal-vikt);
    color: var(--dampad);
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  nav a:hover {
    color: var(--elfenben);
  }
  /* Menyn i huvudet större än i foten (#57) – foten behåller den lilla texten. */
  .huvud nav a {
    font-size: 1.07rem;
  }
  /* Kontakt på datorn: uppgifterna öppnas under ordet (huvudet) eller ovanför (foten). */
  .kontakt-ruta {
    position: relative;
  }
  .kontakt-ruta summary {
    list-style: none;
    cursor: pointer;
    text-transform: uppercase;
    letter-spacing: 0.25em;
    font-size: 1.07rem;
    font-weight: var(--versal-vikt);
    color: var(--dampad);
    min-height: 44px;
    display: flex;
    align-items: center;
  }
  .kontakt-ruta summary::-webkit-details-marker {
    display: none;
  }
  .kontakt-ruta summary:hover {
    color: var(--elfenben);
  }
  .kontakt-ruta .uppgifter {
    position: absolute;
    right: 0;
    top: 100%;
    z-index: 3;
    display: flex;
    flex-direction: column;
    font-style: normal;
    text-align: left;
    white-space: nowrap;
    background: var(--yta);
    border: 1px solid rgb(184 149 90 / 0.4);
    padding: 0.75rem 1.25rem;
    font-size: 1rem;
    color: var(--elfenben);
  }
  .fot .kontakt-ruta summary {
    font-size: 0.8rem;
  }
  .fot .kontakt-ruta .uppgifter {
    top: auto;
    bottom: 100%;
    right: 50%;
    transform: translateX(50%);
  }
  .kontakt-bred {
    display: none;
  }
  @media (min-width: 56rem) {
    .kontakt-smal {
      display: none;
    }
    .kontakt-bred {
      display: block;
    }
  }
  .fot {
    padding: 4rem 1rem 3rem;
    text-align: center;
    color: var(--dampad);
    font-size: 0.95rem;
  }
  .fotmeny {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem 1.5rem;
    margin-top: 1.5rem;
  }
  .fot p {
    margin: 1.25rem 0 0;
    letter-spacing: 0.1em;
  }
</style>
