// Cloudflare Workers med statiska filer (B-03). Ingen serverkod – bara det Astro bygger till dist/.
// Byggs och publiceras av Cloudflare Workers Builds (docs/processmall.md, 3b): main → `wrangler deploy`
// (prod), andra brancher → `wrangler versions upload --preview-alias stage` ⇒ https://stage-leo.<konto>.workers.dev.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "leo",
  "compatibility_date": "2026-09-25",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "workers_dev": true,
  "preview_urls": true
}
