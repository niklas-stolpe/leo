// Cloudflare Workers med statiska filer (B-03). Ingen serverkod – bara det Astro bygger till dist/.
// Byggs av Cloudflare Workers Builds (docs/processmall.md, 3b): main → `wrangler versions upload` (en ny version –
// prod byts bara med scripts/publicera-version.sh), andra brancher → `--preview-alias stage` ⇒ https://stage-leo.<konto>.workers.dev.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "leo",
  "compatibility_date": "2026-09-25",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "workers_dev": true,
  "preview_urls": true
}
